      <joint name="front_left_steering_joint" type="revolute">
        <parent>base_link</parent>
        <child>front_left_steering_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <dynamics>
            <damping>0.1</damping>
          </dynamics>
          <limit>
            <lower>-0.6108652382</lower>
            <upper>0.6108652382</upper>
            <velocity>8.0</velocity>
            <effort>100</effort>
          </limit>
        </axis>
      </joint>

      <joint name="front_right_steering_joint" type="revolute">
        <parent>base_link</parent>
        <child>front_right_steering_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <dynamics>
            <damping>0.1</damping>
          </dynamics>
          <limit>
            <lower>-0.6108652382</lower>
            <upper>0.6108652382</upper>
            <velocity>8.0</velocity>
            <effort>100</effort>
          </limit>
        </axis>
      </joint>

      <joint name="front_left_wheel_joint" type="revolute">
        <parent>front_left_steering_link</parent>
        <child>front_left_wheel_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <dynamics>
            <damping>0.0</damping>
          </dynamics>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
            <velocity>200.0</velocity>
            <effort>100.0</effort>
          </limit>
        </axis>
