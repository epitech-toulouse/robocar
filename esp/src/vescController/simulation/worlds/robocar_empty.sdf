<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="robocar_empty">
    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>120 120</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>120 120</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- CIRCUIT DE FORMULE 1 (Échelle Robocar) -->
    
    <!-- BORDURES EXTERIEURES ROUGES -->
    <model name="f1_border_n">
      <static>true</static><pose>10 7 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>25 0.2 1</size></box></geometry></collision><visual name="v"><geometry><box><size>25 0.2 1</size></box></geometry><material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual></link>
    </model>
    <model name="f1_border_s">
      <static>true</static><pose>10 -7 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>25 0.2 1</size></box></geometry></collision><visual name="v"><geometry><box><size>25 0.2 1</size></box></geometry><material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual></link>
    </model>
    <model name="f1_border_e">
      <static>true</static><pose>22.5 0 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.2 14 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 14 1</size></box></geometry><material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual></link>
    </model>
    <model name="f1_border_w">
      <static>true</static><pose>-2.5 0 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.2 14 1</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 14 1</size></box></geometry><material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual></link>
    </model>

    <!-- LES CHICANES EN BIAIS (Vibreurs Blancs et Bleus) -->
    <model name="chicane_1">
      <static>true</static><pose>5 2.5 0.5 0 0 -0.785</pose>
      <link name="link"><collision name="c"><geometry><box><size>6 0.2 1</size></box></geometry></collision><visual name="v"><geometry><box><size>6 0.2 1</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link>
    </model>
    <model name="chicane_2">
      <static>true</static><pose>9 -2.5 0.5 0 0 0.785</pose>
      <link name="link"><collision name="c"><geometry><box><size>6 0.2 1</size></box></geometry></collision><visual name="v"><geometry><box><size>6 0.2 1</size></box></geometry><material><ambient>0.2 0.4 1 1</ambient><diffuse>0.2 0.4 1 1</diffuse></material></visual></link>
    </model>

    <!-- OBSTACLE DE LA GRANDE EPINGLE (Vibreurs Jaunes) -->
    <model name="hairpin_island">
      <static>true</static><pose>17.5 0 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>6 8 1</size></box></geometry></collision><visual name="v"><geometry><box><size>6 8 1</size></box></geometry><material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material></visual></link>
    </model>

    <!-- SÉPARATEURS DROITS -->
    <model name="straight_block_1">
      <static>true</static><pose>10 4.5 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>8 0.5 1</size></box></geometry></collision><visual name="v"><geometry><box><size>8 0.5 1</size></box></geometry><material><ambient>0.3 0.8 0.3 1</ambient><diffuse>0.3 0.8 0.3 1</diffuse></material></visual></link>
    </model>
    <model name="straight_block_2">
      <static>true</static><pose>2 -4.5 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>6 0.5 1</size></box></geometry></collision><visual name="v"><geometry><box><size>6 0.5 1</size></box></geometry><material><ambient>0.3 0.8 0.3 1</ambient><diffuse>0.3 0.8 0.3 1</diffuse></material></visual></link>
    </model>

    <model name="robocar">
      <pose>0 0 0.08 0 0 0</pose>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.15</wheel_separation>
        <wheel_radius>0.05</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <max_linear_velocity>3.5</max_linear_velocity>
        <min_linear_velocity>-3.5</min_linear_velocity>
        <!-- L'angle max (45 degrés) pour la rotation sur un empattement de ~30cm donne une angular velocity max très spécifique. 45 deg = 0.785 rad -->
        <max_angular_velocity>5.5</max_angular_velocity>
        <min_angular_velocity>-5.5</min_angular_velocity>
      </plugin>

      <link name="base_link">
        <pose>0 0 0.1 0 0 0</pose>
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.05</ixx>
            <iyy>0.05</iyy>
            <izz>0.05</izz>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>
          </inertia>
        </inertial>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.30 0.15 0.10</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.30 0.15 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.12 0.12 0.12 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="left_wheel_link">
        <pose>0 0.085 0.05 1.57079632679 0 0</pose>
        <inertial>
          <mass>0.35</mass>
          <inertia>
            <ixx>0.001</ixx>
            <iyy>0.001</iyy>
            <izz>0.001</izz>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.03</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.03</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.04 0.04 0.04 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="right_wheel_link">
        <pose>0 -0.085 0.05 1.57079632679 0 0</pose>
        <inertial>
          <mass>0.35</mass>
          <inertia>
            <ixx>0.001</ixx>
            <iyy>0.001</iyy>
            <izz>0.001</izz>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.03</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.03</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.04 0.04 0.04 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>left_wheel_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <dynamics>
            <damping>0.2</damping>
          </dynamics>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>

      <joint name="right_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>right_wheel_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <dynamics>
            <damping>0.2</damping>
          </dynamics>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>

      <link name="front_caster_link">
        <pose>0.12 0 0.03 0 0 0</pose>
        <inertial>
          <mass>0.08</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <iyy>0.0001</iyy>
            <izz>0.0001</izz>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.03</radius>
            </sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.03</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>

      <joint name="front_caster_joint" type="ball">
        <parent>base_link</parent>
        <child>front_caster_link</child>
      </joint>

      <link name="rear_caster_link">
        <pose>-0.18 0 0.03 0 0 0</pose>
        <inertial>
          <mass>0.08</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <iyy>0.0001</iyy>
            <izz>0.0001</izz>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.03</radius>
            </sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.03</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>

      <joint name="rear_caster_joint" type="ball">
        <parent>base_link</parent>
        <child>rear_caster_link</child>
      </joint>

      <link name="lidar_link">
        <pose>0 0 0.13 0 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.001</ixx>
            <iyy>0.001</iyy>
            <izz>0.001</izz>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>
          </inertia>
        </inertial>

        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.04</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.04</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>

        <sensor name="top_lidar" type="gpu_lidar">
          <pose>0 0 0.04 0 0 0</pose>
          <topic>/scan</topic>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>true</visualize>
          <ray>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>0.0</min_angle>
                <max_angle>6.26573201466</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.05</min>
              <max>12.0</max>
              <resolution>0.01</resolution>
            </range>
          </ray>
        </sensor>
      </link>

      <joint name="lidar_mount_joint" type="fixed">
        <parent>base_link</parent>
        <child>lidar_link</child>
      </joint>
    </model>
  </world>
</sdf>
