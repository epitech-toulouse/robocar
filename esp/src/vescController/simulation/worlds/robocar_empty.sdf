    <!-- LIGNE D'ARRIVEE -->
    <model name="finish_line">
      <static>true</static><pose>7.0 14.0 0.01 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.5 2.0 0.02</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link>
    </model>

    <model name="robocar">
      <pose>0 0 0 0 0 0</pose>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.18</wheel_separation>
        <wheel_radius>0.03</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <odom_publish_frequency>50</odom_publish_frequency>
        <max_linear_acceleration>1000.0</max_linear_acceleration>
        <min_linear_acceleration>-1000.0</min_linear_acceleration>
        <max_angular_acceleration>8.0</max_angular_acceleration>
        <min_angular_acceleration>-8.0</min_angular_acceleration>
        <max_linear_velocity>1000.0</max_linear_velocity>
        <min_linear_velocity>-1000.0</min_linear_velocity>
        <max_angular_velocity>5.0</max_angular_velocity>
        <min_angular_velocity>-5.0</min_angular_velocity>
      </plugin>

      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>front_left_steering_joint</joint_name>
        <topic>/robocar/front_left_steering_cmd</topic>
        <p_gain>30.0</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>1.0</d_gain>
        <cmd_max>80.0</cmd_max>
        <cmd_min>-80.0</cmd_min>
      </plugin>

      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>front_right_steering_joint</joint_name>
        <topic>/robocar/front_right_steering_cmd</topic>
        <p_gain>30.0</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>1.0</d_gain>
        <cmd_max>80.0</cmd_max>
        <cmd_min>-80.0</cmd_min>
      </plugin>

      <link name="base_link">
