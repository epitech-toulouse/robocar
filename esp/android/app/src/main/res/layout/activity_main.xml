<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".MainActivity">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        android:visibility="visible" />

    <ImageView
        android:id="@+id/processed_image_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:visibility="gone" />

    <com.example.myapplication.LaneOverlayView
        android:id="@+id/lane_overlay_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="#99000000"
        android:fontFamily="monospace"
        android:padding="12dp"
        android:text="@string/camera_initializing"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

    <ScrollView
        android:id="@+id/ble_control_panel"
        android:layout_width="330dp"
        android:layout_height="match_parent"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#AA081018"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/text_ble_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="BLE: idle"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/button_ble_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Status" />

                <Button
                    android:id="@+id/button_ble_logs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Logs" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/button_ble_arm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Arm" />

                <Button
                    android:id="@+id/button_ble_stop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#CC8A1020"
                    android:text="STOP"
                    android:textColor="@android:color/white" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Manual"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_manual_forward"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Forward" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/button_manual_left"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Left" />

                <Button
                    android:id="@+id/button_manual_right"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Right" />
            </LinearLayout>

            <Button
                android:id="@+id/button_manual_backward"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Backward" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Algorithms"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/check_algo_manual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manual"
                android:textColor="@android:color/white" />

            <CheckBox
                android:id="@+id/check_algo_close_obstacle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Close obstacle"
                android:textColor="@android:color/white" />

            <CheckBox
                android:id="@+id/check_algo_lidar_corridor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Corridor LiDAR"
                android:textColor="@android:color/white" />

            <CheckBox
                android:id="@+id/check_algo_gps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="GPS"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/button_apply_algorithms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apply algorithms" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="GPS goal"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edit_gps_lat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Latitude"
                android:inputType="numberDecimal|numberSigned"
                android:text="43.610382"
                android:textColor="@android:color/white"
                android:textColorHint="#CCFFFFFF" />

            <EditText
                android:id="@+id/edit_gps_lon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Longitude"
                android:inputType="numberDecimal|numberSigned"
                android:text="1.431465"
                android:textColor="@android:color/white"
                android:textColorHint="#CCFFFFFF" />

            <Button
                android:id="@+id/button_apply_gps_goal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apply GPS goal" />

            <TextView
                android:id="@+id/text_ble_response"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:maxLines="8"
                android:text="-"
                android:textColor="@android:color/white"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/button_toggle_lens"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#CC102030"
            android:text="Reset zoom 1.0x"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/text_zoom_ratio"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#99000000"
            android:padding="8dp"
            android:text="Zoom: 1.00x"
            android:textColor="@android:color/white" />

        <SeekBar
            android:id="@+id/seek_zoom_ratio"
            android:layout_width="220dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/button_toggle_mask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#CC102030"
            android:text="@string/show_mask_view"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/button_back_bluetooth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#CC102030"
            android:text="@string/back_bluetooth"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/button_toggle_tuning_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#CC102030"
            android:text="Masquer reglages"
            android:textColor="@android:color/white" />

        <ScrollView
            android:id="@+id/tuning_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#AA101820"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reglage OpenCV"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_section_camera"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#CC203040"
                    android:text="Camera / Presets"
                    android:textColor="@android:color/white" />

                <LinearLayout
                    android:id="@+id/section_camera"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_image_shift"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@android:color/white" />

                    <SeekBar
                        android:id="@+id/seek_image_shift"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <Button
                        android:id="@+id/button_save_preset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Sauver preset" />

                    <Button
                        android:id="@+id/button_load_preset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Charger preset" />
                </LinearLayout>

                <Button
                    android:id="@+id/button_section_roi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#CC203040"
                    android:text="ROI"
                    android:textColor="@android:color/white" />

                <LinearLayout
                    android:id="@+id/section_roi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_roi_top"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@android:color/white" />

                    <SeekBar
                        android:id="@+id/seek_roi_top"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/text_roi_bottom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@android:color/white" />

                    <SeekBar
                        android:id="@+id/seek_roi_bottom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/text_roi_center_x"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@android:color/white" />

                    <SeekBar
                        android:id="@+id/seek_roi_center_x"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/text_roi_top_width"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@android:color/white" />

                    <SeekBar
                        android:id="@+id/seek_roi_top_width"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/text_roi_bottom_width"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@android:color/white" />

                    <SeekBar
                        android:id="@+id/seek_roi_bottom_width"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <Button
                    android:id="@+id/button_section_canny"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#CC203040"
                    android:text="Canny"
                    android:textColor="@android:color/white" />

                <LinearLayout
                    android:id="@+id/section_canny"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/text_canny_low"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@android:color/white" />

                    <SeekBar
                        android:id="@+id/seek_canny_low"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/text_canny_high"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@android:color/white" />

                    <SeekBar
                        android:id="@+id/seek_canny_high"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <Button
                    android:id="@+id/button_section_hough"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#CC203040"
                    android:text="Hough"
                    android:textColor="@android:color/white" />

                <LinearLayout
                    android:id="@+id/section_hough"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/text_hough_threshold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@android:color/white" />

                    <SeekBar
                        android:id="@+id/seek_hough_threshold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/text_min_line_length"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@android:color/white" />

                    <SeekBar
                        android:id="@+id/seek_min_line_length"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/text_max_line_gap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@android:color/white" />

                    <SeekBar
                        android:id="@+id/seek_max_line_gap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <Button
                    android:id="@+id/button_section_stop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#CC203040"
                    android:text="STOP"
                    android:textColor="@android:color/white" />

                <LinearLayout
                    android:id="@+id/section_stop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/text_stop_min_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@android:color/white" />

                    <SeekBar
                        android:id="@+id/seek_stop_min_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/text_stop_max_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@android:color/white" />

                    <SeekBar
                        android:id="@+id/seek_stop_max_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <Button
                    android:id="@+id/button_reset_tuning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Reinitialiser" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</FrameLayout>
